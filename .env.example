# =============================================================================
# TradeBot Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# Everything here is OPTIONAL. With an empty .env the bot still runs:
# market data falls back to yfinance (no account/ID) and sentiment falls back
# to a rule-based scorer when Ollama is unreachable.

# --- Data: Finnhub (optional) -------------------------------------------------
# yfinance is the default source and needs no key. A Finnhub key is tried first
# for history if set, with automatic fallback to yfinance. Leave blank to skip.
FINNHUB_API_KEY=

# --- Notifications: Discord (primary) -----------------------------------------
# Create a webhook in your server: Channel settings > Integrations > Webhooks.
# Used for real-time signal alerts and the weekly newsletter.
DISCORD_WEBHOOK_URL=

# --- Notifications: Telegram (optional, legacy) -------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sentiment: Ollama (local AI, rule-based fallback) ------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# --- Trading / analysis -------------------------------------------------------
# Seed watchlist (the persisted watchlist is created from this on first run).
WATCHLIST=AAPL,MSFT,NVDA
# Seconds between analysis cycles while the active window is open.
ANALYSIS_INTERVAL=300

# --- Active window (energy sobriety, local to TIMEZONE) -----------------------
# The bot only works during these hours (matches Trade Republic availability).
# Outside the window background tasks sleep until the next open.
TIMEZONE=Europe/Paris
ACTIVE_START_HOUR=8
ACTIVE_END_HOUR=23
# Active weekdays: Mon=0 .. Sun=6
ACTIVE_WEEKDAYS=0,1,2,3,4

# --- Simulated portfolio (bot-managed paper trading) --------------------------
SIM_STARTING_CASH=10000
SIM_TRADE_BUDGET=50
SIM_BUY_CONFIDENCE=0.25
SIM_SELL_CONFIDENCE=0.25
