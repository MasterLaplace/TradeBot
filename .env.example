# =============================================================================
# TradeBot Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# --- Finnhub (Free tier: 30 req/s) ---
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- Telegram Notifications ---
# 1. Talk to @BotFather on Telegram to create a bot
# 2. Get your chat_id by talking to @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Ollama (Local AI) ---
# Default: http://localhost:11434 (standard Ollama port)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# --- Trading Configuration ---
# Default symbols to monitor (comma-separated ISINs or tickers)
WATCHLIST=AAPL,MSFT,NVDA
# Analysis interval in seconds (default: 300 = 5 min)
ANALYSIS_INTERVAL=300
